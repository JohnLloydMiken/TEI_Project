generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
  schemas  = ["dbo"]
}

model Customer {
  id           Int         @id @default(autoincrement())
  accountCode  String
  accountNo    String
  customerName String
  status       String      @default("Pending") // "Pending" | "BD Retained"

  // Optional — keep for future use
  address       String?
  email         String?
  phone         String?
  depositAmount Decimal?

  batchId Int
  batch   UploadBatch @relation(fields: [batchId], references: [id])

  @@unique([accountNo, batchId])
  @@map("Customer")
  @@schema("dbo")
}

model UploadBatch {
  id         Int        @id @default(autoincrement())
  fileName   String
  uploadedBy Int
  uploadedAt DateTime   @default(now())
  month      Int
  year       Int
  customers  Customer[]

  @@map("UploadBatch")
  @@schema("dbo")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CSD")
  createdAt DateTime @default(now())

  @@map("User")
  @@schema("dbo")
}